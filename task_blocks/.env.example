OPENROUTER_API_KEY=

# --- Endpoints ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Host: http://localhost:11434 ; Docker Compose: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Models ---
# Local models (Ollama)
ROUTER_MODEL=qwen3:1.7b
VERIFIER_MODEL=qwen3:1.7b
EMBEDDING_MODEL=nomic-embed-text

# Remote models (OpenRouter)
# The engine follows the model ID: a name containing a slash goes to
# OpenRouter, one without it goes to the local Ollama. To run entirely
# offline, for instance when the free-tier daily quota is spent, set these
# three to a local model: THERAPIST_MODEL=qwen3:1.7b and so on. Replies are
# weaker from a 1.7B model, but routing, verification and memory all work.
THERAPIST_MODEL=google/gemma-4-31b-it:free
LOGICAL_MODEL=google/gemma-4-26b-a4b-it:free
FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Behaviour ---
# Number of most recent messages passed to the generating models
HISTORY_MAX_MESSAGES=12
# Maximum characters in an agent reply before the verifier rejects it
MAX_REPLY_CHARS=4000
# Sampling temperatures
ROUTER_TEMPERATURE=0.0
VERIFIER_TEMPERATURE=0.0
THERAPIST_TEMPERATURE=0.7
LOGICAL_TEMPERATURE=0.2
FALLBACK_TEMPERATURE=0.5
# Verifier-triggered retries before the fixed safe reply is sent
MAX_REGENERATION_ATTEMPTS=1

# --- Storage ---
# Directory for SQLite files (checkpointer + long-term store).
# Host: ./data ; Docker Compose: /data (volume)
DATA_DIR=./data

# --- Logging ---
LOG_LEVEL=INFO

# --- Observability ---
# Where OpenTelemetry spans are sent. Leave empty to run without tracing;
# Docker Compose sets this to http://phoenix:6006 for the app service.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=task-blocks
# Only needed if the Phoenix collector has auth enabled. The Compose stack
# disables Phoenix auth, so this is normally empty.
PHOENIX_API_KEY=

# Grafana login (Compose only; the UI is bound to 127.0.0.1)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
