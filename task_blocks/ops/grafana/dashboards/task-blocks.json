{
  "uid": "task-blocks-overview",
  "title": "task-blocks overview",
  "description": "Agent throughput, latency, quality and cost. Quality panels (verifier verdicts, safe fallbacks) are the ones that matter most: an agent can serve HTTP 200s while answering badly.",
  "tags": ["task-blocks", "agent"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "task-blocks-prometheus" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Traffic and latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Turns per minute, by route",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqpm", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_requests_total[5m])) by (route) * 60",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Turn latency (p50 / p95)",
      "description": "End-to-end, including every LLM call, tool call and any regeneration. Tens of seconds is normal with free-tier remote models and CPU-only local inference.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(agent_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(agent_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "row",
      "title": "Quality",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Verifier pass rate (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(verifier_verdicts_total{result=\"pass\"}[1h])) / clamp_min(sum(rate(verifier_verdicts_total[1h])), 0.001)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Verifier verdicts, by deciding stage",
      "description": "source=rules means a deterministic rule decided; source=llm means the verifier model did. Rules override the model, so a rising 'rules' fail count points at a concrete, testable defect.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(verifier_verdicts_total[5m])) by (result, source) * 60",
          "legendFormat": "{{result}} ({{source}})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Fallbacks per minute, by reason",
      "description": "verifier_rejected drives a regeneration; safe_reply means the user received fixed text.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fallback_total[5m])) by (reason) * 60",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Router confidence (p10 / p50)",
      "description": "A falling p10 means more genuinely ambiguous messages, or a degrading router.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.1, sum(rate(router_confidence_bucket[30m])) by (le))",
          "legendFormat": "p10"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum(rate(router_confidence_bucket[30m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Crisis detections per minute, by detector",
      "description": "detector=keyword firing while detector=model stays flat means the router model is under-detecting.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(crisis_detected_total[15m])) by (detector) * 60",
          "legendFormat": "{{detector}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Models, tools and memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM call latency p95, by model",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(llm_latency_seconds_bucket[10m])) by (le, model))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM error rate, by model",
      "description": "Mostly free-tier 429s. Transport fallbacks absorb these until the fallback model is throttled too.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_calls_total{status=\"error\"}[10m])) by (model) / clamp_min(sum(rate(llm_calls_total[10m])) by (model), 0.001)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tokens per minute, by model and kind",
      "description": "The cost signal. Gaps mean the provider reported no usage, which free endpoints often do not — so this understates rather than overstates.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_tokens_total[10m])) by (model, type) * 60",
          "legendFormat": "{{model}} {{type}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tool calls and memory ops per minute",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tool_calls_total[10m])) by (tool, status) * 60",
          "legendFormat": "tool {{tool}} ({{status}})"
        },
        {
          "refId": "B",
          "expr": "sum(rate(memory_ops_total[10m])) by (op, status) * 60",
          "legendFormat": "memory {{op}} ({{status}})"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Build and model configuration",
      "description": "Which models this instance is actually running, straight from the metrics endpoint.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 37 },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "expr": "task_blocks_build_info",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
